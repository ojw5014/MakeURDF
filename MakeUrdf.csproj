  <!-- OpenJigWare 참조 이원화:
       trunk 안(개발 환경, ..\OpenJigWare 프로젝트 존재)에서는 프로젝트 참조 — 항상 최신 DLL 로 빌드.
       GitHub 클론처럼 원본 프로젝트가 없으면 동봉된 lib\OpenJigWare.dll 참조 — 단독 빌드 가능. -->
  <Choose>
    <When Condition="Exists('..\OpenJigWare\OpenJigWare.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\OpenJigWare\OpenJigWare.csproj">
          <Project>{E0E62640-C66D-46A3-A57C-80A42A1C3E39}</Project>
          <Name>OpenJigWare</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <Reference Include="OpenJigWare">
          <HintPath>lib\OpenJigWare.dll</HintPath>
        </Reference>
      </ItemGroup>
    </Otherwise>
  </Choose>
